# ═══════════════════════════════════════════════════════════════
# PressBook 360 CRM — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values:
#   cp .env.local.example .env.local
# ═══════════════════════════════════════════════════════════════

# ── Clerk Auth ────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Clerk redirect routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ── Database (PostgreSQL) ────────────────────────────────────
# Your existing PressBook database on the DigitalOcean droplet
DATABASE_URL=postgres://pressbook:YOUR_PASSWORD@45.55.221.160:5432/pressbook_crm

# ── Resend (Email) ───────────────────────────────────────────
RESEND_API_KEY=re_REPLACE_ME

# ── Stripe (Payments) ────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── Anthropic (AI) ───────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# ── Email Verification (optional, paid layer) ────────────────
# MILLIONVERIFIER_API_KEY=REPLACE_ME
